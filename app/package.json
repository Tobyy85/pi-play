{
    "name": "pi-play",
    "private": true,
    "version": "0.0.0",
    "main": "dist-electron/main/main.js",
    "homepage": "https://github.com/Tobyy85/pi-play",
    "description": "",
    "author": {
        "name": "Tobyy85",
        "email": "154422539+Tobyy85@users.noreply.github.com"
    },
    "scripts": {
        "lint": "eslint .",
        "preview": "vite preview",
        "format": "prettier --write .",
        "dev": "npm run build:electron && concurrently -n \"Vite,TSC, \" -c \"green,blue,reset\" \"npm:vite:dev\" \"npm:electron:watch\" \"npm:electron:start\"",
        "build": "npm run build:electron && vite build",
        "vite:dev": "vite",
        "electron:watch": "concurrently \"tsc -w -p tsconfig.electron.json\" \"tsc-alias -w -p tsconfig.electron.json\"",
        "electron:start": "wait-on tcp:3000 dist-electron/main/main.js && nodemon --watch dist-electron --ext js --exec \"electron .\"",
        "build:electron": "tsc -p tsconfig.electron.json && tsc-alias -p tsconfig.electron.json",
        "dist": "npm run build && electron-builder",
        "dist:win": "npm run build && electron-builder --win",
        "dist:linux": "npm run build && electron-builder --linux"
    },
    "build": {
        "appId": "com.pi-play.pi-play",
        "productName": "pi play",
        "files": [
            "dist/**/*",
            "dist-electron/**/*"
        ],
        "directories": {
            "buildResources": "assets",
            "output": "release"
        },
        "linux": {
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "arm64"
                    ]
                }
            ],
            "icon": "assets/icon.png",
            "category": "Utility",
            "maintainer": "Tobyy85"
        },
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "assets/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createStartMenuShortcut": true
        }
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.1.14",
        "dbus-next": "^0.10.2",
        "dotenv": "^17.3.1",
        "maplibre-gl": "^5.17.0",
        "nmea-simple": "^3.3.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-icons": "^5.5.0",
        "react-map-gl": "^8.1.0",
        "react-router-dom": "^7.9.3",
        "serialport": "^13.0.0",
        "simplex-noise": "^4.0.3",
        "tailwindcss": "^4.1.14",
        "vcard4-ts": "^0.4.1",
        "zustand": "^5.0.11"
    },
    "devDependencies": {
        "@eslint/js": "^9.37.0",
        "@types/node": "^24.9.2",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.1",
        "@vitejs/plugin-react": "^5.0.4",
        "concurrently": "^9.2.1",
        "electron": "^38.2.2",
        "electron-builder": "^26.0.12",
        "eslint": "^9.37.0",
        "eslint-plugin-react-hooks": "^6.1.1",
        "eslint-plugin-react-refresh": "^0.4.23",
        "globals": "^16.4.0",
        "nodemon": "^3.1.10",
        "prettier": "^3.6.2",
        "prettier-plugin-classnames": "^0.8.5",
        "prettier-plugin-merge": "^0.8.0",
        "prettier-plugin-tailwindcss": "^0.7.1",
        "tsc-alias": "^1.8.16",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.46.0",
        "vite": "^7.1.9",
        "wait-on": "^9.0.1"
    }
}
